generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  BOTH
}

enum DeliveryType {
  HOME
  DESK
}

enum OrderStatus {
  NEW
  CONTACTED
  DELIVERING
  COMPLETED
  CANCELED
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductType {
  id         Int         @id @default(autoincrement())
  slug       String      @unique
  nameAr     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  products   Product[]
  variations Variation[]
}

model Product {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  nameAr          String
  subtitleAr      String
  descriptionAr   String
  price           Decimal
  discountActive  Boolean            @default(false)
  discountedPrice Decimal?
  gender          Gender
  isFeatured      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  productTypeId   Int
  productType     ProductType        @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  variations      ProductVariation[]
  orderItems      OrderItem[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  altAr     String
  sortOrder Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variation {
  id            Int              @id @default(autoincrement())
  nameAr        String
  createdAt     DateTime         @default(now())
  productTypeId Int
  productType   ProductType      @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  values        VariationValue[]
}

model VariationValue {
  id                 Int                @id @default(autoincrement())
  valueAr            String
  hexColor           String?
  createdAt          DateTime           @default(now())
  variationId        Int
  variation          Variation          @relation(fields: [variationId], references: [id], onDelete: Cascade)
  productVariations  ProductVariation[]
  selectedInOrder    OrderItemSelection[]
}

model ProductVariation {
  id               Int            @id @default(autoincrement())
  productId        Int
  variationValueId Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationValue   VariationValue @relation(fields: [variationValueId], references: [id], onDelete: Cascade)

  @@unique([productId, variationValueId])
}

model Order {
  id             Int         @id @default(autoincrement())
  fullName       String
  phone          String
  wilaya         String
  address        String
  deliveryType   DeliveryType
  notes          String?
  status         OrderStatus  @default(NEW)
  totalAmount    Decimal
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id          Int                  @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int                  @default(1)
  unitPrice   Decimal
  lineTotal   Decimal
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  selections  OrderItemSelection[]
}

model OrderItemSelection {
  id               Int            @id @default(autoincrement())
  orderItemId      Int
  variationValueId Int
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variationValue   VariationValue @relation(fields: [variationValueId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, variationValueId])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  nameAr    String
  roleAr    String
  textAr    String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
