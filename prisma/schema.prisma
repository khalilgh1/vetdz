generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MALE
  FEMALE
  BOTH
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductType {
  id         Int         @id @default(autoincrement())
  slug       String      @unique
  nameAr     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  products   Product[]
  variations Variation[]
}

model Product {
  id              Int                @id @default(autoincrement())
  slug            String             @unique
  nameAr          String
  subtitleAr      String
  descriptionAr   String
  price           Decimal
  discountActive  Boolean            @default(false)
  discountedPrice Decimal?
  gender          Gender
  isFeatured      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  productTypeId   Int
  productType     ProductType        @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  images          ProductImage[]
  variations      ProductVariation[]
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  url       String
  altAr     String
  sortOrder Int      @default(0)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variation {
  id            Int              @id @default(autoincrement())
  nameAr        String
  createdAt     DateTime         @default(now())
  productTypeId Int
  productType   ProductType      @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  values        VariationValue[]
}

model VariationValue {
  id                 Int                @id @default(autoincrement())
  valueAr            String
  hexColor           String?
  createdAt          DateTime           @default(now())
  variationId        Int
  variation          Variation          @relation(fields: [variationId], references: [id], onDelete: Cascade)
  productVariations  ProductVariation[]
}

model ProductVariation {
  id               Int            @id @default(autoincrement())
  productId        Int
  variationValueId Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationValue   VariationValue @relation(fields: [variationValueId], references: [id], onDelete: Cascade)

  @@unique([productId, variationValueId])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  nameAr    String
  roleAr    String
  textAr    String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentEmbedding {
  id        Int                     @id @default(autoincrement())
  text      String
  metadata  Json                    @default("{}")
  embedding Unsupported("vector(768)")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @default(now()) @updatedAt @map("updated_at")

  @@map("document_embeddings")
}

